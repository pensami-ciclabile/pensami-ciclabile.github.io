<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or translations[lang].home.title or "PensaMI Ciclabile" }}</title>
    <link rel="alternate" hreflang="en" href="/en{{ page.url | replace('/en/', '/') | replace('/it/', '/') }}" />
    <link rel="alternate" hreflang="it" href="/it{{ page.url | replace('/en/', '/') | replace('/it/', '/') }}" />
    <link rel="alternate" hreflang="x-default" href="/en{{ page.url | replace('/en/', '/') | replace('/it/', '/') }}" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/ca3f122cf7.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    {% include "navbar.html" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.html" %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        localStorage.setItem('lang', '{{ lang or "en" }}');
    </script>
    </body>
</html>
